# ==========================================
# WhatsApp Taxi Bridge — Environment Config
# ==========================================
# העתק קובץ זה ל-.env ומלא את הערכים.
# על Render: הגדר כ-Environment Variables בדשבורד.

# --- חובה ---
# מפתח אבטחה לכל קריאות ה-API (בחר מחרוזת אקראית ארוכה)
BRIDGE_API_KEY=replace_with_strong_random_key_here

# --- אופציונלי ---
# URL של MongoDB Atlas (חינמי) לשמירת ה-Session בענן
MONGODB_URI=

# URL של Google Apps Script Web App לקבלת מיקומים
GAS_SCRIPT_URL=

# Origins מורשים לפניות CORS (מופרדים בפסיק)
CORS_ORIGINS=

# --- גיבויים (תשתית GAS) ---
# הערכים הבאים צריכים להיות מוגדרים ב-Script Properties של Google Apps Script
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=

# --- Render בלבד (אל תגדיר מקומית) ---
# SESSION_DIR נקבע אוטומטית מ-render.yaml (/data/sessions)
# PORT נקבע אוטומטית על ידי Render (10000)
# RENDER_URL הוא הכתובת של השרת שלך לצורך self-ping
RENDER_URL=
