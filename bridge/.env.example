# ==========================================
# WhatsApp Taxi Bridge — Environment Config
# ==========================================
# Copy to bridge/.env — NEVER commit real secrets.
# Use a NEW WhatsApp manager session + NEW group for Wave Unify.
# On Render: set the same keys in the Dashboard.

# --- Required ---
BRIDGE_API_KEY=replace_with_strong_random_key_here

# --- Optional ---
MONGODB_URI=
GAS_SCRIPT_URL=
CORS_ORIGINS=http://localhost:5273,http://localhost:5275

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL=

# --- Render helpers ---
RENDER_URL=
PORT=3000
