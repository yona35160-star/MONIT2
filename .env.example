# .env.example — TAXIPRO / MONIT2 (Wave Fresh Start)
# Copy to .env and fill values for a BRAND-NEW Firebase + GAS + WhatsApp setup.
# See START.md for numbered steps. NEVER commit .env / .env.local.

# === Google Apps Script Web App (leave empty until you Deploy — paste URL in Login too) ===
VITE_WEBAPP_URL=

# === Firebase (new project only — Console → Project Settings → Web App) ===
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# === Optional ===
VITE_GEMINI_API_KEY=
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
VITE_GOOGLE_CLIENT_ID=

# === WhatsApp Bridge (new manager bot + new group; match bridge/.env) ===
VITE_WHATSAPP_BRIDGE_URL=http://localhost:3000
VITE_BRIDGE_API_KEY=
VITE_WHATSAPP_RENDER_URL=
VITE_WHATSAPP_GROUP_JID=
VITE_STATION_WHATSAPP_PHONE=

# === Local Unify URLs (safe defaults — not secrets) ===
VITE_OPS_SITE_URL=http://localhost:5275/admin.html
VITE_APP_SITE_URL=http://localhost:5273/app.html
VITE_SITE_URL=http://localhost:5273/app.html
VITE_DRIVER_SITE_URL=http://localhost:5273/app.html?role=driver
VITE_ADMIN_SITE_URL=http://localhost:5275/admin.html
