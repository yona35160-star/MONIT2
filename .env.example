# .env.example — TAXIPRO / MONIT2 (Wave Unify)
# Copy to .env and fill REAL values for a NEW Firebase + NEW GAS project.
# NEVER commit .env / .env.local.

# === NEW backend (Google Apps Script Web App) ===
VITE_WEBAPP_URL=https://script.google.com/macros/s/YOUR_NEW_DEPLOYMENT_ID/exec

# === NEW Firebase project (Console → Project Settings → Web App) ===
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_new_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_new_project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_new_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_new_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=your_vapid_key_for_push_notifications

# === Gemini (Ops AI assist — optional) ===
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# === Telegram alerts (optional) ===
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_chat_id_here

# === WhatsApp Bridge (NEW manager bot + NEW group) ===
# Must match BRIDGE_API_KEY in bridge/.env
VITE_WHATSAPP_BRIDGE_URL=http://localhost:3000
VITE_BRIDGE_API_KEY=replace_with_strong_random_key_here
VITE_WHATSAPP_RENDER_URL=
VITE_WHATSAPP_GROUP_JID=
VITE_STATION_WHATSAPP_PHONE=

# === Unify site URLs (2 screens) ===
VITE_OPS_SITE_URL=http://localhost:5275/admin.html
VITE_APP_SITE_URL=http://localhost:5273/app.html
# Legacy aliases (kept for older code paths during migration)
VITE_SITE_URL=http://localhost:5273/app.html
VITE_DRIVER_SITE_URL=http://localhost:5273/app.html?role=driver
VITE_ADMIN_SITE_URL=http://localhost:5275/admin.html

# === Optional Google OAuth client ===
VITE_GOOGLE_CLIENT_ID=
