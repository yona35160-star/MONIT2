# .env.example — TAXIPRO / MONIT2
# Copy to .env and fill real values. NEVER commit .env / .env.local.

# === Google Apps Script (primary backend) ===
VITE_WEBAPP_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# === Firebase (Console → Project Settings → Web App) ===
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=your_vapid_key_for_push_notifications

# === Gemini (Admin AI assist — Google AI Studio free tier) ===
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# === Telegram alerts (optional) ===
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_chat_id_here

# === WhatsApp Bridge (must match bridge/.env BRIDGE_API_KEY) ===
VITE_WHATSAPP_BRIDGE_URL=http://localhost:3000
VITE_BRIDGE_API_KEY=replace_with_strong_random_key_here
VITE_WHATSAPP_RENDER_URL=
VITE_WHATSAPP_GROUP_JID=
VITE_STATION_WHATSAPP_PHONE=

# === Deployed site URLs (set after Vercel/Netlify deploy, then redeploy) ===
VITE_SITE_URL=http://localhost:5273/passenger.html
VITE_DRIVER_SITE_URL=http://localhost:5274/driver.html
VITE_ADMIN_SITE_URL=http://localhost:5275/admin.html

# === Optional Google OAuth client (if used) ===
VITE_GOOGLE_CLIENT_ID=
