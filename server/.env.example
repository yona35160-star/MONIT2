# TAXIPRO / MONIT2 — local Mongo API (Wave Mongo)
# Copy to server/.env. NEVER commit secrets.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/taxipro

# Local-ready stubs (change in any shared/prod environment)
ADMIN_EMAIL=admin@taxi.co.il
ADMIN_PASSWORD=123456
JWT_SECRET=local-dev-only-change-me

# OTP accepted in local/dev when WhatsApp is not sending codes
DEV_OTP=123456
