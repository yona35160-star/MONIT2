{
  "name": "TAXIPRO / MONIT2 Design System",
  "version": "2.0.0",
  "direction": "rtl",
  "apps": ["ops", "ride"],
  "theme": {
    "mood": "premium taxi night",
    "notes": "Full visual refresh Wave Fresh Start — amber taxi accent on deep charcoal; Heebo-first Hebrew typography."
  },
  "typography": {
    "fontFamily": {
      "sans": ["Heebo", "Rubik", "Assistant", "system-ui", "sans-serif"],
      "display": ["Heebo", "Rubik", "sans-serif"]
    },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700;800&display=swap",
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    },
    "weights": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700, "extrabold": 800 }
  },
  "colors": {
    "brand": {
      "primary": { "hex": "#F5A524", "tailwind": "primary-500", "usage": "CTA, accents, taxi yellow-amber" },
      "primaryDark": { "hex": "#D4890F", "tailwind": "primary-600" },
      "primaryLight": { "hex": "#FFC857", "tailwind": "primary-300" },
      "accent": { "hex": "#22D3EE", "tailwind": "accent-400", "usage": "live status, map pins" }
    },
    "surface": {
      "bg": { "hex": "#0B0F14", "tailwind": "surface-bg" },
      "card": { "hex": "#141A22", "tailwind": "surface-card" },
      "elevated": { "hex": "#1C2430", "tailwind": "surface-elevated" },
      "border": { "hex": "#2A3441", "tailwind": "surface-border" }
    },
    "text": {
      "primary": { "hex": "#F3F4F6", "tailwind": "text-primary" },
      "secondary": { "hex": "#9CA3AF", "tailwind": "text-secondary" },
      "muted": { "hex": "#6B7280", "tailwind": "text-muted" }
    },
    "semantic": {
      "success": "#22C55E",
      "warning": "#F59E0B",
      "danger": "#EF4444",
      "info": "#38BDF8"
    }
  },
  "radius": { "sm": "0.5rem", "md": "0.875rem", "lg": "1.25rem", "xl": "1.5rem", "full": "9999px" },
  "shadow": {
    "card": "0 8px 30px rgba(0,0,0,0.35)",
    "glow": "0 0 24px rgba(245,165,36,0.35)"
  },
  "components": {
    "Button": { "primary": "bg-primary-500 text-black font-semibold rounded-lg hover:bg-primary-600" },
    "Card": { "base": "bg-surface-card border border-surface-border rounded-xl shadow-card" },
    "Input": { "base": "bg-surface-elevated border border-surface-border rounded-lg text-text-primary" }
  },
  "ia": {
    "ops": "Control center = admin + station dispatch",
    "ride": "Single app with passenger/driver role picker"
  }
}