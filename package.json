{
  "name": "taxi-dispatch-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode admin --open /admin.html#/station-order",
    "dev:passenger": "vite --mode passenger --open /passenger.html",
    "dev:driver": "vite --mode driver --open /driver.html",
    "dev:admin": "vite --mode admin --open /admin.html",
    "build": "vite build",
    "build:all": "npm run build:passenger && npm run build:driver && npm run build:admin",
    "build:passenger": "vite build --mode passenger",
    "build:driver": "vite build --mode driver",
    "build:admin": "vite build --mode admin",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bridge": "node bridge/multi-bot.js"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@types/lodash": "^4.17.23",
    "clsx": "^2.1.1",
    "firebase": "^12.8.0",
    "framer-motion": "^12.34.3",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lodash": "^4.17.23",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.71.1",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/leaflet.heat": "^0.2.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^0.19.8",
    "workbox-core": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0",
    "workbox-window": "^7.4.0"
  }
}
